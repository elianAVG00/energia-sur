# Local development only. Copy to ignored .env and set a non-empty password.
# Do not reuse real credentials or share the completed file.
POSTGRES_DB=energia_sur
POSTGRES_USER=energia_sur
POSTGRES_PASSWORD=

# CU03 assistant: server-side only. Leave empty to keep the static fallback;
# never commit a real key or expose it to the frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# CU09 overlay: backend-only application connection. Uncomment and complete in
# ignored .env only; the value must never be pasted into docs, chat or Git.
# CU09_DATABASE_URL=postgresql+psycopg://energia_sur:CHANGE_ME@db:5432/energia_sur
